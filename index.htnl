<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Preview Card Component</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main class="product-card">

    <picture class="product-picture">
      <source
        media="(min-width: 600px)"
        srcset="https://raw.githubusercontent.com/annafkt/frontend-mentor-challenges/main/challenges/product-preview-card-component/images/image-product-desktop.jpg">

      <img
        class="product-image"
        src="https://raw.githubusercontent.com/annafkt/frontend-mentor-challenges/main/challenges/product-preview-card-component/images/image-product-mobile.jpg"
        alt="Chanel Gabrielle Essence Eau De Parfum perfume bottle surrounded by leaves">
    </picture>

    <section class="product-info">
      <p class="category">PERFUME</p>

      <h1>Gabrielle Essence Eau De Parfum</h1>

      <p class="description">
        A floral, solar and voluptuous interpretation composed by Olivier Polge, Perfumer-Creator for the House of CHANEL.
      </p>

      <div class="prices">
        <span class="current-price">$149.99</span>
        <span class="old-price">$169.99</span>
      </div>

      <button class="cart-button" type="button">
        <img
          src="https://raw.githubusercontent.com/annafkt/frontend-mentor-challenges/ad3fac60ad20698348acd39adfeddde1b0b6494c/product-preview-card-component/images/icon-cart.svg"
          alt=""
          class="cart-icon">
        Add to Cart
      </button>
    </section>

  </main>
</body>
</html>
